# Copy to .env (git-ignored) and fill in. Never commit real values.

# Tracing (required for the neatlogs integration)
NEATLOGS_API_KEY=
# Optional: service-account token (scopes observability:read/write) to publish failure clusters as incidents
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_ORG_ID=

# LLM access: either a LiteLLM proxy key ...
LITELLM_API_KEY=
LITELLM_BASE_URL=
# ... or a Factory API key, with every role routed through `droid exec`
FACTORY_API_KEY=
# PAPERCI_MODEL_ALL=factory:glm-5.3-flash
# PAPERCI_MODEL_BUILDER=factory:deepseek-v4.1-flash
# PAPERCI_MODEL_SOLVER=factory:deepseek-v4.1-flash

# Optional: read-only GitHub token (public repos) to avoid the 60 requests/hour anonymous limit
GH_TOKEN=

# Optional: web app invite codes (comma-separated) and autopilot
# PAPERCI_INVITE_CODES=
# PAPERCI_SUBMITS_PER_HOUR=10
# PAPERCI_AUTOPILOT=1
