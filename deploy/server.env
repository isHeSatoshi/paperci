# Non-secret knobs for the cloud server (t3.large: 2 vCPU, 8 GB RAM, 50 GB disk).
# Secrets (LLM key, neatlogs key, invite codes) live in /home/ubuntu/paperci/.env, which is never committed.
PAPERCI_AUTOPILOT=1
PAPERCI_CYCLE_EVERY=5400
PAPERCI_CYCLE_PREPARE=6
PAPERCI_CYCLE_REPRODUCE=1
PAPERCI_NIGHTLY_HOUR=3
PAPERCI_TZ_OFFSET_H=5.5
PAPERCI_SANDBOX_CPUS=2
PAPERCI_SANDBOX_MEM=5g
PAPERCI_DISK_MIN_GB=10
PAPERCI_WEB_INTAKE_WAIT=600
PYTHONIOENCODING=utf-8
