# PaperCI on your own machine. Copy to the repo root as .env and keep ONE of the three LLM options below.
# Everything else (sandbox, egress allowlist, sealed claims, verifier) is the same code the cloud server runs.

# ---------- Option A: Ollama (default)  https://ollama.com
#   ollama pull qwen2.5-coder:14b && ollama pull llama3.1:8b
PAPERCI_LOCAL_BASE_URL=http://localhost:11434/v1
PAPERCI_MODEL_ALL=local:llama3.1:8b
PAPERCI_MODEL_BUILDER=local:qwen2.5-coder:14b
PAPERCI_MODEL_SOLVER=local:qwen2.5-coder:14b

# ---------- Option B: LM Studio  https://lmstudio.ai  (Developer tab -> Start server)
# PAPERCI_LOCAL_BASE_URL=http://localhost:1234/v1
# PAPERCI_MODEL_ALL=local:meta-llama-3.1-8b-instruct
# PAPERCI_MODEL_BUILDER=local:qwen2.5-coder-14b-instruct

# ---------- Option C: a local LiteLLM proxy in front of anything (Ollama, vLLM, or your own API keys)
#   pip install "litellm[proxy]" && litellm --config deploy/local/litellm.yaml --port 4000
# PAPERCI_LOCAL_BASE_URL=http://localhost:4000/v1
# PAPERCI_LOCAL_API_KEY=sk-paperci-local
# PAPERCI_MODEL_ALL=local:paperci-verifier
# PAPERCI_MODEL_BUILDER=local:paperci-builder
# PAPERCI_MODEL_SOLVER=local:paperci-builder
# If the proxy routes to a paid API, give its price (USD per 1M tokens) so the per-paper dollar caps apply:
# PAPERCI_LOCAL_PRICE_IN=0.15
# PAPERCI_LOCAL_PRICE_OUT=0.60

# Small models that ignore the `tools` field can use PaperCI's JSON tool protocol instead (auto-detected too):
# PAPERCI_LOCAL_TOOLS=json
# Local models are slower than hosted ones; give each call and each paper more time:
PAPERCI_LOCAL_TIMEOUT=900
PAPERCI_PAPER_WALL=5400

# Sandbox size: leave headroom for the model if it runs on the same machine.
PAPERCI_SANDBOX_CPUS=4
PAPERCI_SANDBOX_MEM=6g

# Optional: neatlogs tracing (leave empty to run without it) and a read-only GitHub token for more API headroom.
NEATLOGS_API_KEY=
GH_TOKEN=
PYTHONIOENCODING=utf-8
